# Supabase → Project Settings → Database → Connection string
# DATABASE_URL — "Transaction" pooler (порт 6543, режим pgbouncer) — используется приложением в рантайме
# DIRECT_URL  — "Session"/прямое подключение (порт 5432) — нужно Prisma только для migrate/seed
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Базовый URL сайта (для метаданных, sitemap, абсолютных ссылок в письмах/чеках)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Админка ---
ADMIN_SESSION_SECRET="сгенерируйте: node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="сменить-на-надёжный-пароль"

# --- Supabase Storage (фото товаров в админке) ---
# Project Settings → API → Project URL / service_role key
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=

# --- Кабинет клиента (NextAuth) ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="сгенерируйте: node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Ниже будет заполнено в отдельных задачах (платежи / Nova Poshta / аналитика) ---
# LIQPAY_PUBLIC_KEY=
# LIQPAY_PRIVATE_KEY=
# NOVA_POSHTA_API_KEY=
# NEXT_PUBLIC_GA4_ID=
# NEXT_PUBLIC_META_PIXEL_ID=
